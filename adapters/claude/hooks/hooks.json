{
  "description": "Open Magi Stop hook backstop and PostToolUse contract reminder for active deliberation loops",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] && [ -x \"${CLAUDE_PLUGIN_ROOT}/hooks/magi-stop\" ]; then exec \"${CLAUDE_PLUGIN_ROOT}/hooks/magi-stop\"; fi; exit 0'",
            "timeout": 10,
            "statusMessage": "Checking Magi state"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] && [ -x \"${CLAUDE_PLUGIN_ROOT}/hooks/magi-tool-reminder\" ]; then exec \"${CLAUDE_PLUGIN_ROOT}/hooks/magi-tool-reminder\"; fi; exit 0'",
            "timeout": 5,
            "statusMessage": "Checking Magi contract"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] && [ -x \"${CLAUDE_PLUGIN_ROOT}/hooks/magi-guard\" ]; then exec \"${CLAUDE_PLUGIN_ROOT}/hooks/magi-guard\"; fi; exit 0'",
            "timeout": 5,
            "statusMessage": "Guarding Magi phases"
          }
        ]
      }
    ]
  }
}
